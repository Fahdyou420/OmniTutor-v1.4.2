# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The local URL where this dashboard is hosted.
# Typically http://localhost:3005 for local development.
APP_URL="http://localhost:3005"

# OPENROUTER_API_KEY: Required for the Python Brain Engine to communicate with OpenRouter's free LLMs.
# Get your free key at https://openrouter.ai/
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
